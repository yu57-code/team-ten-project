@* 醫療／資料審核人員版面：深藍側欄＋內容區。
   Components/Pages/Reviewer 底下的頁面透過該資料夾的 _Imports.razor 自動套用。 *@
@inherits LayoutComponentBase
@using ImagingAI.Web.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IServiceProvider Services

@{ var current = CurrentUser; }
@if (current is { } user)
{
    <MudThemeProvider Theme="AppThemes.Reviewer" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <div class="ia-shell ia-shell--reviewer">
        <AppSidebar Subtitle="醫療／資料審核人員" Items="_items" User="user" />
        <main class="ia-main">
            @Body
        </main>
    </div>
}

@code {
    private IReadOnlyList<NavItem> _items = [];
    private DevAuthStateProvider? _trustedState;
    private bool _realMode;
    private bool _disposed;

    private UserAccount? CurrentUser
    {
        get
        {
            if (_realMode)
                return AppSidebar.ReadTrustedUser(_trustedState, UserRole.MEDICAL_REVIEWER);

            var mock = Services.GetRequiredService<IAuthService>();
            return mock.CurrentUser is { Role: UserRole.MEDICAL_REVIEWER } user
                ? user : mock.GetDemoUser(UserRole.MEDICAL_REVIEWER);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _realMode = Services.GetService<DevAuthWebRegistration.EnabledMode>() is not null;
        if (_realMode)
        {
            _trustedState = Services.GetRequiredService<DevAuthStateProvider>();
            _trustedState.AuthenticationStateChanged += OnIdentityChanged;
        }

        var counts = _realMode ? default : await Services.GetRequiredService<INavBadgeService>()
            .GetReviewerCountsAsync();

        _items =
        [
            new("總覽", "/reviewer", Icons.Material.Outlined.GridView, NavLinkMatch.All),
            new("上傳病例", "/reviewer/upload", Icons.Material.Outlined.FileUpload),
            new("待覆核", "/reviewer/review", Icons.Material.Outlined.FactCheck,
                Badge: counts?.PendingReview, BadgeTone: NavBadgeTone.Purple),
            new("異常佇列", "/reviewer/exceptions", Icons.Material.Outlined.WarningAmber,
                Badge: counts?.OpenExceptions, BadgeTone: NavBadgeTone.Red),
            new("結構化資料", "/reviewer/structured-data", Icons.Material.Outlined.Dataset),
            new("個人處理紀錄", "/reviewer/history", Icons.Material.Outlined.History),
            new("稽核軌跡", "/reviewer/audit", Icons.Material.Outlined.VerifiedUser),
        ];
    }

    private void OnIdentityChanged(Task<AuthenticationState> state) => _ = InvokeAsync(() =>
    {
        if (!_disposed)
            StateHasChanged();
    });

    public void Dispose()
    {
        _disposed = true;
        if (_trustedState is not null)
            _trustedState.AuthenticationStateChanged -= OnIdentityChanged;
    }
}
