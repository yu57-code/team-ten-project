
@page "/reviewer/exceptions"
@implements IAsyncDisposable

@inject IExceptionService ExceptionService
@inject IAuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>異常佇列｜影像病例結構化平台</PageTitle>

<PageHeader Title="異常佇列"
            Subtitle="記錄各階段驗證失敗的病例；人工處理與修正後重新驗證，無法修正者標記並結案（不寫入 FHIR）。" />

<FilterChips TValue="ExceptionCategory?"
             Options="CategoryOptions"
             Value="_category"
             ValueChanged="OnCategoryChanged"
             AriaLabel="依異常類別篩選" />

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0 && _selected is null)
{
    <div class="ia-card empty-card">
        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt"
                 Class="empty-icon" />
        <div>
            <div class="empty-title">目前沒有待處理的異常</div>
            <p class="muted small">
                目前沒有未結案異常。
            </p>
        </div>
    </div>
}
else
{
    <div class="layout">

        @* 左側：異常清單 *@
        <section class="list" aria-label="異常清單">

            @foreach (var item in FilteredItems)
            {
                <button type="button"
                        disabled="@_busy"
                        class="@(item.Id == _selected?.Id ? "item is-on" : "item")"
                        @onclick="() => Select(item)">

                    <span class="item-top">
                        <span class="ia-mono muted">
                            @item.Id・@item.CaseId
                        </span>

                        <StatusBadge Tone="StatusStyles.Tone(item.Status)"
                                     Text="@ExceptionText.StatusLabel(item.Status)" />
                    </span>

                    <StatusBadge Tone="BadgeTone.Err"
                                 Text="@ExceptionText.CategoryLabel(item.Category)" />

                    <span class="item-desc">
                        @item.Description
                    </span>

                    <span class="item-meta">
                        @item.CreatedAt.ToString("MM/dd HH:mm")
                        ・指派：@AssigneeText(item.Assignee)
                    </span>
                </button>
            }

            @if (!FilteredItems.Any())
            {
                <p class="muted small pad">
                    這個類別目前沒有異常。
                </p>
            }
        </section>

        @* 右側：異常詳細 *@
        @if (_selected is not null)
        {
            <section class="ia-card detail">

                <div class="detail-head">
                    <div>
                        <div class="title-row">
                            <h2 class="detail-title">
                                @ExceptionText.CategoryLabel(_selected.Category)
                            </h2>

                            <StatusBadge Tone="StatusStyles.Tone(_selected.Status)"
                                         Text="@ExceptionText.StatusLabel(_selected.Status)" />
                        </div>

                        <p class="muted small meta">
                            <span class="ia-mono">@_selected.Id</span>
                            ・病例
                            <span class="ia-mono">@_selected.CaseId</span>
                            ・建立於 @_selected.CreatedAt.ToString("MM/dd HH:mm")
                            ・指派 @AssigneeText(_selected.Assignee)
                        </p>
                    </div>

                    <MudButton Href="@($"/reviewer/review/{_selected.CaseId}")"
                               Variant="Variant.Outlined"
                               Class="ia-btn">
                        檢視原始病歷與解析結果
                    </MudButton>
                </div>

                <div class="reason">
                    <b>異常原因：</b>@_selected.Description
                </div>

                @if (_selected.Code == "MRN_MISMATCH")
                {
                    <div class="reason" role="status">
                        <b>病例處理進度：</b>@ExceptionText.CaseProcessingLabel(_selected.CaseProcessingStatus)
                    </div>
                    @if (_progressError is not null)
                    {
                        <p role="alert">@_progressError</p>
                    }
                    @if (_revalidationError is not null)
                    {
                        <p role="alert">@_revalidationError</p>
                    }
                    <div class="reason">
                        <MudButton OnClick="LoadMrnEvidenceAsync" Disabled="@(_evidenceLoading || _busy || _pendingCorrection is not null)" Variant="Variant.Outlined">
                            @(_evidenceLoading ? "載入中…" : "查看 MRN 比對內容")
                        </MudButton>
                        @if (_evidenceError is not null)
                        {
                            <p role="alert">@_evidenceError</p>
                        }
                        @if (_mrnEvidence is not null)
                        {
                            <p><b>上傳 MRN：</b><span class="ia-mono">@_mrnEvidence.UploadedMrn</span></p>
                            @foreach (var candidate in _mrnEvidence.Candidates)
                            {
                                <p><b>OCR MRN：</b><span class="ia-mono">@candidate.Value</span>
                                    ｜第 @candidate.Page 頁｜信心分數 @candidate.Confidence.ToString("P1")
                                    ｜區塊 @candidate.BlockId｜位置 @string.Join(", ", candidate.Bbox)</p>
                            }
                            <p class="muted small">OCR 候選尚未經人工確認；目前修正版本：@(_mrnEvidence.CurrentCorrectionVersion?.ToString() ?? "未提供")。</p>
                        }
                    </div>
                }

                @* 驗證失敗位置 *@
                <div>
                    <div class="sub-title">失敗位置</div>

                    <ol class="track" aria-label="失敗位置">
                        @for (var i = 0; i < ExceptionText.ValidationSteps.Count; i++)
                        {
                            var state = i < _selected.FailedStep
                                ? "done"
                                : i == _selected.FailedStep
                                    ? "fail"
                                    : "todo";

                            <li class="track-step">
                                <span class="@($"track-dot track-dot--{state}")"
                                      aria-hidden="true">
                                    @(state == "done"
                                        ? "✓"
                                        : state == "fail"
                                            ? "!"
                                            : (i + 1).ToString())
                                </span>

                                <span class="@(state == "fail" ? "track-label is-fail" : "track-label")">
                                    @ExceptionText.ValidationSteps[i]
                                </span>

                                @if (state == "fail")
                                {
                                    <span class="ia-sr-only">（失敗）</span>
                                }
                            </li>
                        }
                    </ol>
                </div>

                @* 欄位比對 *@
                <div class="compare">
                    <table class="ia-table">
                        <thead>
                            <tr>
                                <th>欄位</th>
                                <th>AI 擷取／系統值</th>
                                <th>比對來源</th>
                                <th>判定</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in _selected.Comparisons)
                            {
                                <tr>
                                    <td class="strong">@row.Field</td>
                                    <td class="ia-mono">@row.Actual</td>
                                    <td class="ia-mono">@row.Expected</td>
                                    <td>
                                        <StatusBadge Tone="StatusStyles.Tone(row.Level)"
                                                     Text="@row.Verdict" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* 人工處理與修正 *@
                <div class="fix">
                    <h3 class="fix-title">人工處理與修正</h3>

                    <div class="fix-fields">
                        <div class="fix-field">
                            <label class="ia-label" for="fix-value">
                                @(IsMrnMismatch ? "人工確認 MRN" : _selected.FixLabel)
                            </label>

                            <input id="fix-value"
                                   class="ia-field"
                                   disabled="@DraftLocked"
                                   @bind="_fixValue"
                                   @bind:event="oninput" />
                        </div>

                        <div class="fix-field fix-field--sm">
                            <label class="ia-label">
                                目前異常狀態
                            </label>

                            <div class="ia-field">
                                @ExceptionText.StatusLabel(_selected.Status)
                            </div>
                        </div>
                    </div>

                    @if (IsMrnMismatch)
                    {
                        <div class="fix-field">
                            <label class="ia-label" for="mrn-reason">修正原因</label>
                            <select id="mrn-reason" class="ia-field" @bind="_reason" disabled="@DraftLocked">
                                <option value="">請選擇修正原因</option>
                                <option value="UPLOAD_MRN_INPUT_ERROR">上傳 MRN 輸入錯誤</option>
                                <option value="OCR_RECOGNITION_ERROR">OCR 辨識錯誤</option>
                                <option value="DOCUMENT_CASE_MISMATCH">文件與病例不符</option>
                            </select>
                        </div>
                        <div class="fix-field">
                            <span class="ia-label">來源確認（請對照原始文件後勾選，不會自動填入 MRN）</span>
                            @if (_mrnEvidence is null)
                            {
                                <p class="muted small">請先查看 MRN 比對內容。</p>
                            }
                            else
                            {
                                @foreach (var reference in _mrnEvidence.Candidates.Select(c => new MrnEvidenceReference(c.Page, c.BlockId)).Distinct())
                                {
                                    <label>
                                        <input type="checkbox" disabled="@DraftLocked"
                                               checked="@_confirmedSources.Contains(reference)"
                                               @onchange="args => ConfirmSource(reference, args.Value is true)" />
                                        已核對第 @reference.Page 頁、區塊 @reference.BlockId
                                    </label>
                                }
                            }
                        </div>
                        @if (_reason == MrnCorrectionReason.DOCUMENT_CASE_MISMATCH)
                        {
                            <p role="alert">文件與病例不符：僅保存紀錄，仍需確認來源，不會恢復處理。</p>
                        }
                        @if (_pendingCorrection is not null)
                        {
                            <p role="alert">保存結果尚未確認；請按「儲存人工修正」重試原請求。切換病例會清除本頁草稿，切回後須先重新查看證據。</p>
                        }
                    }

                    @if (_selected.AllowMerge)
                    {
                        <MudCheckBox T="bool"
                                     @bind-Value="_merge"
                                     Disabled="@(_busy || IsPendingRevalidation)"
                                     Color="Color.Tertiary"
                                     Class="merge"
                                     Label="申請合併至既有病人（目前僅模擬，不會修改 Patient 資料）" />
                    }

                    <div>
                        <label class="ia-label" for="fix-note">
                            處理說明
                        </label>

                        <textarea id="fix-note"
                                  class="ia-field"
                                  rows="2"
                                  disabled="@DraftLocked"
                                  maxlength="2000"
                                  placeholder="@(IsMrnMismatch ? "請填寫修正依據（必填，將加密保存）" : "此類異常的人工處置尚未開放")"
                                  @bind="_note"
                                  @bind:event="oninput"></textarea>
                    </div>

                    <div class="fix-actions">
                        <span class="muted small">
                            目前僅開放 MRN 不一致的人工修正與重新驗證；無法處理尚未開放。
                        </span>

                        <div class="buttons">

                            <MudButton Variant="Variant.Outlined"
                                       Class="ia-btn ia-btn--danger"
                                       Disabled="true"
                                       OnClick="MarkUnresolvableAsync">
                                標記為無法處理
                            </MudButton>

                            @if (IsPendingRevalidation)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           DropShadow="false"
                                           Class="ia-btn"
                                            Disabled="@(!CanRevalidateMrn)"
                                           OnClick="RevalidateAsync">
                                    @(_busy ? "驗證中…" : _pendingRevalidation is null ? "重新驗證" : "重試重新驗證")
                                </MudButton>
                            }
                            else if (_selected.Status == ExceptionStatus.Pending)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Tertiary"
                                           DropShadow="false"
                                           Class="ia-btn"
                                           Disabled="@(!CanSaveMrnCorrection)"
                                           OnClick="ResolveAsync">
                                    儲存人工修正
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "case")]
    public string? CaseFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "exception")]
    public string? ExceptionFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "revalidateRequest")]
    public string? RevalidationRequestFromQuery { get; set; }

    private IReadOnlyList<ExceptionItem>? _items;
    private ExceptionItem? _selected;
    private ExceptionCategory? _category;

    private string _fixValue = string.Empty;
    private bool _merge;
    private string _note = string.Empty;
    private bool _busy;
    private MrnEvidence? _mrnEvidence;
    private string? _evidenceError;
    private bool _evidenceLoading;
    private long _evidenceRequest;
    private MrnCorrectionReason? _reason;
    private readonly HashSet<MrnEvidenceReference> _confirmedSources = [];
    private MrnCorrectionRequest? _pendingCorrection;
    private MrnRevalidationRequest? _pendingRevalidation;
    private Guid? _retryRevalidationId;
    private string? _revalidationError;
    private string? _progressError;
    private CancellationTokenSource? _progressPoll;
    private bool IsMrnMismatch => _selected?.Code == "MRN_MISMATCH";
    private bool DraftLocked => !IsMrnMismatch || _busy || IsPendingRevalidation || _pendingCorrection is not null;
    private bool CanSaveMrnCorrection => IsMrnMismatch && !_busy && !_evidenceLoading &&
        _selected?.Status == ExceptionStatus.Pending &&
        (_pendingCorrection is not null ||
         (_mrnEvidence?.CurrentCorrectionVersion is >= 0 && _evidenceError is null && _reason.HasValue &&
          !string.IsNullOrWhiteSpace(_fixValue) && _fixValue.Length <= 50 &&
          !string.IsNullOrWhiteSpace(_note) && _note.Length <= 2000 && _confirmedSources.Count > 0));
    private bool CanRevalidateMrn => ExceptionText.CanRevalidate(_selected, _busy) && !_evidenceLoading;

    private void ConfirmSource(MrnEvidenceReference reference, bool confirmed)
    {
        if (DraftLocked) return;
        if (confirmed) _confirmedSources.Add(reference); else _confirmedSources.Remove(reference);
    }

    private async Task LoadMrnEvidenceAsync()
    {
        if (_selected?.Code != "MRN_MISMATCH" || _evidenceLoading || _busy || _pendingCorrection is not null) return;
        var id = _selected.Id;
        var request = ++_evidenceRequest;
        _evidenceLoading = true;
        _evidenceError = null;
        _mrnEvidence = null;
        _confirmedSources.Clear();
        try
        {
            var result = await ExceptionService.GetMrnEvidenceAsync(id);
            if (_selected?.Id == id && request == _evidenceRequest)
            {
                if (result.Evidence is not null && result.Evidence.ReportId != _selected.CaseId)
                    _evidenceError = "證據與目前病例不符，請重新載入。";
                else
                {
                    _mrnEvidence = result.Evidence;
                    _evidenceError = result.Error;
                }
            }
        }
        catch
        {
            if (_selected?.Id == id && request == _evidenceRequest)
                _evidenceError = "無法取得 MRN 證據，請稍後重試。";
        }
        finally
        {
            if (request == _evidenceRequest) _evidenceLoading = false;
        }
    }

    private bool IsPendingRevalidation =>
        _selected?.Status == ExceptionStatus.FixedPendingRevalidation;

    private string UserName =>
        Auth.CurrentUser?.DisplayName
        ?? Auth.GetDemoUser(UserRole.Reviewer).DisplayName;

    private IEnumerable<ExceptionItem> FilteredItems =>
        (_items ?? [])
            .Where(e => _category is null || e.Category == _category);

    private IReadOnlyList<ChipOption<ExceptionCategory?>> CategoryOptions =>
    [
        new(null, "全部", _items?.Count ?? 0),

        .. Enum.GetValues<ExceptionCategory>()
            .Select(c => new ChipOption<ExceptionCategory?>(
                c,
                ExceptionText.CategoryLabel(c),
                _items?.Count(e => e.Category == c) ?? 0))
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(preferExceptionId: ExceptionFromQuery, preferCaseId: CaseFromQuery);
    }

    private async Task LoadAsync(
        string? preferCaseId = null,
        string? preferExceptionId = null)
    {
        _items = await ExceptionService.GetOpenExceptionsAsync();

        ExceptionItem? next = null;
        if (!string.IsNullOrWhiteSpace(preferExceptionId))
        {
            next = _items.FirstOrDefault(e => e.Id == preferExceptionId)
                ?? await ExceptionService.GetExceptionAsync(preferExceptionId);
        }
        next ??= preferCaseId is null ? null : _items.FirstOrDefault(e => e.CaseId == preferCaseId);
        next ??= FilteredItems.FirstOrDefault();

        if (next is not null)
        {
            Select(next);
            if (Guid.TryParse(RevalidationRequestFromQuery, out var retryId) &&
                next.Status == ExceptionStatus.FixedPendingRevalidation &&
                next.CaseProcessingStatus == "MRN_REVIEW_REQUIRED")
                _retryRevalidationId = retryId;
            if (next.CaseProcessingStatus is "MRN_REVALIDATED" or "MRN_DEID_PROCESSING")
            {
                SetReviewUri(next.Id, null);
                StartProgressPolling(next.Id);
            }
        }
        else
        {
            _selected = null;
        }
    }

    private void OnCategoryChanged(ExceptionCategory? category)
    {
        if (_busy) return;
        _category = category;

        if (_selected is null ||
            (category is not null && _selected.Category != category))
        {
            var first = FilteredItems.FirstOrDefault();

            if (first is not null)
            {
                Select(first);
            }
            else
            {
                ClearMrnDraft();
                _selected = null;
            }
        }
    }

    private void Select(ExceptionItem item)
    {
        ClearMrnDraft();
        _selected = item;
        SetReviewUri(item.Id, null);
        _fixValue = item.Code == "MRN_MISMATCH" ? string.Empty : item.FixValue;
        _merge = false;
        _note = item.Code == "MRN_MISMATCH" ? string.Empty : item.ResolutionNote ?? string.Empty;
    }

    private void ClearMrnDraft()
    {
        StopProgressPolling();
        ++_evidenceRequest;
        _mrnEvidence = null;
        _evidenceError = null;
        _evidenceLoading = false;
        _reason = null;
        _confirmedSources.Clear();
        _pendingCorrection = null;
        _pendingRevalidation = null;
        _retryRevalidationId = null;
        _revalidationError = null;
        _progressError = null;
        _fixValue = string.Empty;
        _merge = false;
        _note = string.Empty;
    }

    private string AssigneeText(string assignee) =>
        string.IsNullOrEmpty(assignee)
            ? "未指派"
            : assignee == UserName
                ? "我"
                : assignee;

    private async Task ResolveAsync()
    {
        if (!CanSaveMrnCorrection || _selected is null) return;
        var id = _selected.Id;
        var selected = _selected;
        _pendingCorrection ??= new MrnCorrectionRequest(Guid.NewGuid(), _mrnEvidence!.CurrentCorrectionVersion!.Value,
            _mrnEvidence.OcrAttemptId, _mrnEvidence.OriginalSha256, _mrnEvidence.CandidateSha256,
            _reason!.Value, _fixValue,
            _confirmedSources.OrderBy(r => r.Page).ThenBy(r => r.BlockId, StringComparer.Ordinal).ToArray(), _note);
        _busy = true;
        try
        {
            var result = await ExceptionService.SaveMrnCorrectionAsync(id, _pendingCorrection);
            if (result.Response is { Success: true } saved)
            {
                selected.Status = ExceptionStatus.FixedPendingRevalidation;
                _pendingCorrection = null;
                _fixValue = string.Empty;
                _note = string.Empty;
                _confirmedSources.Clear();
                if (_mrnEvidence is not null)
                    _mrnEvidence = _mrnEvidence with { CurrentCorrectionVersion = saved.CorrectionVersion,
                        LastCorrectionRequestId = saved.RequestId };
                Snackbar.Add("人工修正已保存，等待重新驗證", Severity.Success);
                if (saved.SourceConfirmationRequired)
                    Snackbar.Add("文件與病例不符，仍需確認來源，不會恢復處理。", Severity.Warning);
                try
                {
                    var refreshed = await ExceptionService.GetOpenExceptionsAsync();
                    var current = refreshed.FirstOrDefault(item => item.Id == id);
                    // Do not overwrite confirmed success with a stale/invalid list response.
                    if (current?.Status != ExceptionStatus.FixedPendingRevalidation)
                        throw new InvalidOperationException();
                    _items = refreshed;
                    Select(current);
                }
                catch
                {
                    Snackbar.Add("保存成功，但異常清單更新失敗，請稍後重新整理。", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
                if (!result.OutcomeUnknown) _pendingCorrection = null;
                if (result.StatusCode is 404 or 409 or 501)
                {
                    _mrnEvidence = null;
                    _confirmedSources.Clear();
                    _evidenceError = result.Message;
                }
            }
        }
        catch
        {
            // Keep the exact request: the server may have committed before the connection failed.
            Snackbar.Add("保存結果尚未確認，請按相同按鈕重試原請求。", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevalidateAsync()
    {
        if (!CanRevalidateMrn || _selected is null) return;
        var id = _selected.Id;
        _busy = true;
        _revalidationError = null;
        _progressError = null;
        try
        {
            if (_mrnEvidence is null || _mrnEvidence.ReportId != _selected.CaseId ||
                _mrnEvidence.CurrentCorrectionVersion is null or < 1 || _mrnEvidence.LastCorrectionRequestId is null)
            {
                var evidenceResult = await ExceptionService.GetMrnEvidenceAsync(id);
                if (evidenceResult.Evidence is null || evidenceResult.Error is not null ||
                    evidenceResult.Evidence.ReportId != _selected.CaseId ||
                    evidenceResult.Evidence.CurrentCorrectionVersion is null or < 1 ||
                    evidenceResult.Evidence.LastCorrectionRequestId is null)
                {
                    _revalidationError = evidenceResult.Error ?? "無法取得最新人工修正來源，請重新載入異常。";
                    return;
                }
                _mrnEvidence = evidenceResult.Evidence;
            }

            var evidence = _mrnEvidence;
            _pendingRevalidation ??= new MrnRevalidationRequest(
                _retryRevalidationId ?? Guid.NewGuid(), evidence.CurrentCorrectionVersion!.Value,
                evidence.LastCorrectionRequestId!.Value, evidence.OcrAttemptId,
                evidence.OriginalSha256, evidence.CandidateSha256);
            SetReviewUri(id, _pendingRevalidation.RequestId);

            var result = await ExceptionService.RevalidateMrnAsync(id, _pendingRevalidation);
            if (result.Response is { Success: true } response)
            {
                _pendingRevalidation = null;
                _retryRevalidationId = null;
                SetReviewUri(id, null);
                if (response.Passed)
                {
                    _selected.Status = ExceptionStatus.Resolved;
                    _selected.CaseProcessingStatus = "MRN_REVALIDATED";
                    Snackbar.Add("MRN 重新驗證通過，已排入背景恢復；去識別化尚未完成。", Severity.Success);
                    StartProgressPolling(id);
                }
                else
                {
                    _selected.Status = ExceptionStatus.FixedPendingRevalidation;
                    _selected.CaseProcessingStatus = response.ProcessingStatus;
                    _revalidationError = $"重新驗證未通過（{response.Code}），病例仍維持阻擋。";
                    Snackbar.Add(_revalidationError, Severity.Warning);
                }
                await RefreshSelectedDetailAsync(id);
            }
            else
            {
                _revalidationError = result.Message;
                Snackbar.Add(result.Message, Severity.Error);
                if (!result.OutcomeUnknown)
                {
                    _pendingRevalidation = null;
                    _retryRevalidationId = null;
                    SetReviewUri(id, null);
                    if (result.StatusCode is 404 or 409) await RefreshSelectedDetailAsync(id);
                }
            }
        }
        catch (Exception error) when (error is HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            _revalidationError = "重新驗證結果尚未確認；請使用相同請求識別碼重試。";
            Snackbar.Add(_revalidationError, Severity.Error);
            if (_pendingRevalidation is not null) SetReviewUri(id, _pendingRevalidation.RequestId);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshSelectedDetailAsync(string id)
    {
        var detail = await ExceptionService.GetExceptionAsync(id);
        if (_selected?.Id == id && detail is not null) _selected = detail;
        _items = await ExceptionService.GetOpenExceptionsAsync();
    }

    private void SetReviewUri(string exceptionId, Guid? requestId)
    {
        var uri = Navigation.ToAbsoluteUri("/reviewer/exceptions").ToString();
        var query = new Dictionary<string, string?> { ["exception"] = exceptionId };
        if (requestId.HasValue) query["revalidateRequest"] = requestId.Value.ToString("D");
        var target = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(uri, query);
        Navigation.NavigateTo(target, replace: true);
    }

    private void StartProgressPolling(string exceptionId)
    {
        StopProgressPolling();
        _progressError = null;
        _progressPoll = new CancellationTokenSource();
        _ = PollResumeStatusAsync(exceptionId, _progressPoll.Token);
    }

    private void StopProgressPolling()
    {
        if (_progressPoll is null) return;
        _progressPoll.Cancel();
        _progressPoll.Dispose();
        _progressPoll = null;
    }

    private async Task PollResumeStatusAsync(string exceptionId, CancellationToken token)
    {
        try
        {
            for (var attempt = 0; attempt < 600; attempt++)
            {
                await Task.Delay(TimeSpan.FromSeconds(3), token);
                var detail = await ExceptionService.GetExceptionAsync(exceptionId);
                if (token.IsCancellationRequested || _selected?.Id != exceptionId) return;
                if (detail is null)
                {
                    _progressError = "無法查詢背景恢復狀態；重新整理頁面可再次查詢。";
                    return;
                }
                _selected = detail;
                if (detail.CaseProcessingStatus == "PENDING_REVIEW")
                {
                    _progressError = null;
                    Snackbar.Add("去識別化與重新 OCR 驗證已完成，病例進入待人工覆核。", Severity.Success);
                    return;
                }
                if (detail.CaseProcessingStatus is "DEID_FAILED" or "DEID_VERIFICATION_FAILED" or "MRN_REVIEW_REQUIRED")
                {
                    _progressError = ExceptionText.CaseProcessingLabel(detail.CaseProcessingStatus);
                    return;
                }
                if (detail.CaseProcessingStatus is not ("MRN_REVALIDATED" or "MRN_DEID_PROCESSING"))
                {
                    _progressError = ExceptionText.CaseProcessingLabel(detail.CaseProcessingStatus);
                    return;
                }
                await InvokeAsync(StateHasChanged);
            }
            _progressError = "背景處理仍在進行；可重新整理頁面查詢最新狀態。";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException)
        {
            if (!token.IsCancellationRequested) _progressError = "背景狀態查詢暫時失敗；可重新整理頁面重試。";
        }
        finally
        {
            if (!token.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    public ValueTask DisposeAsync()
    {
        StopProgressPolling();
        return ValueTask.CompletedTask;
    }

    private Task MarkUnresolvableAsync()
    {
        Snackbar.Add("標記為無法處理尚未開放。", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task AfterActionAsync(
        OperationResult result,
        string? exceptionId = null,
        bool reloadOnFailure = false)
    {
        Snackbar.Add(
            result.Message,
            result.Succeeded
                ? Severity.Success
                : Severity.Warning);

        if (result.Succeeded || reloadOnFailure)
        {
            await LoadAsync(preferExceptionId: exceptionId);
        }
    }
}
