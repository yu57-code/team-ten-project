@using ImagingAI.Web.Services.Auth
@implements IDisposable
@page "/"
@page "/login"
@layout EmptyLayout
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>登入｜影像病例結構化平台</PageTitle>

<div class="lf">
    @* ---------- 上方：品牌標籤、大標題、說明 ---------- *@
    <header class="lf-hero">
        <div class="lf-pill">
            <span class="lf-pill-logo" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>
            </span>
            <span class="lf-pill-text">影像病例 → 結構化 → FHIR</span>
        </div>

        <h1 class="lf-title">影像病例結構化平台</h1>
        <p class="lf-desc">病歷經地端 OCR 辨識與去識別化，雲端 AI Agent 擷取欄位後審核驗證，依 TW Core 寫入院內 FHIR Server。</p>
    </header>

    @* ---------- 置中升級款登入卡片 ---------- *@
    <section class="lf-card" aria-label="登入">
        <div class="lf-steps">
            <div class="@StepClass(1)">
                <span class="lf-step-num">1</span>
                <span class="lf-step-label">帳號密碼</span>
            </div>
            <span class="lf-steps-line"></span>
            <div class="@StepClass(2)">
                <span class="lf-step-num">2</span>
                <span class="lf-step-label">多因素驗證 (MFA)</span>
            </div>
        </div>

        @if (_step == 1)
        {
            <form class="lf-body" method="post" action="/login" @ref="_form" @onsubmit="SubmitCredentialsAsync" @onsubmit:preventDefault>
                <div class="lf-heading">
                    <h2>單一入口登入</h2>
                    <p>審核人員與系統管理人員使用同一入口，登入後依權限角色導向對應工作台。</p>
                </div>

                <div class="lf-field">
                    <label class="lf-label" for="acc">帳號</label>
                    <div class="lf-input">
                        <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="lf-input-icon" />
                        @if (Flow is null)
                        {
                            <input id="acc" type="text" placeholder="例如 dr.chen" autocomplete="username"
                                   @bind="_username" @bind:event="oninput" />
                        }
                        else
                        {
                            <input id="acc" type="text" placeholder="例如 dr.chen" autocomplete="username" />
                        }
                    </div>
                </div>

                <div class="lf-field">
                    <div class="lf-label-row">
                        <label class="lf-label" for="pwd">密碼</label>
                        <button type="button" class="lf-link" @onclick="ShowForgotPassword">忘記密碼？</button>
                    </div>
                    <div class="lf-input">
                        <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="lf-input-icon" />
                        @if (Flow is null)
                        {
                            <input id="pwd" type="@(_showPassword ? "text" : "password")" placeholder="請輸入密碼"
                                   autocomplete="current-password" class="has-action"
                                   @bind="_password" @bind:event="oninput" @onkeydown="OnPasswordKeyDown" />
                        }
                        else
                        {
                            <input id="pwd" type="@(_showPassword ? "text" : "password")" placeholder="請輸入密碼"
                                   autocomplete="current-password" class="has-action" />
                        }
                        <button type="button" class="lf-eye" aria-label="@(_showPassword ? "隱藏密碼" : "顯示密碼")"
                                @onclick="() => _showPassword = !_showPassword">
                            <MudIcon Icon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" />
                        </button>
                    </div>
                </div>

                @if (_error is not null)
                {
                    <p class="lf-error" role="alert">@_error</p>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                           Class="lf-submit" Disabled="@(_busy || (Flow is not null && !_interactive))"
                           ButtonType="@(Flow is null ? ButtonType.Button : ButtonType.Submit)" OnClick="SubmitMockButtonAsync"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    下一步
                </MudButton>
            </form>
        }
        else if (_step == 2 && Flow is not null)
        {
            <form class="lf-body" method="post" action="/login" @ref="_otpForm"
                  @onsubmit="VerifyRealOtpAsync" @onsubmit:preventDefault>
                <div class="lf-heading">
                    <h2>輸入驗證碼</h2>
                    <p>請輸入寄送至已驗證電子郵件的 6 位數驗證碼。</p>
                </div>
                <div class="lf-otp-row">
                    @for (var i = 0; i < OtpLength; i++)
                    {
                        <input class="lf-otp" aria-label="驗證碼第 @(i + 1) 碼" inputmode="numeric"
                               data-otp-digit placeholder="·" autocomplete="@(i == 0 ? "one-time-code" : "off")"
                               disabled="@(_busy || Remaining(_deadline) == 0)" />
                    }
                </div>
                @if (_error is not null)
                {
                    <p class="lf-error" role="alert">@_error</p>
                }
                <p class="lf-muted">驗證碼剩餘 @Remaining(_deadline) 秒</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                           Class="lf-submit" ButtonType="ButtonType.Submit" Disabled="@(_busy || Remaining(_deadline) == 0)"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    驗證並登入
                </MudButton>
                <div class="lf-row">
                    <button type="button" class="lf-link" disabled="@_busy" @onclick="CancelRealAsync">← 返回</button>
                    <button type="button" class="lf-link" disabled="@(_busy || Remaining(_deadline) == 0 || Remaining(_resendAt) > 0)"
                            @onclick="ResendRealOtpAsync">重新發送</button>
                    @if (Remaining(_resendAt) is var wait && wait > 0)
                    {
                        <span class="lf-muted">@wait 秒後可重新發送</span>
                    }
                </div>
            </form>
        }
        else if (_step == 2)
        {
            <div class="lf-body">
                <div class="lf-heading">
                    <h2>輸入驗證碼</h2>
                    <p>MFA 驗證服務已發送 6 位數驗證碼至您綁定的驗證器 App。</p>
                </div>

                <div class="lf-otp-row">
                    @for (var i = 0; i < OtpLength; i++)
                    {
                        var index = i;
                        <input class="lf-otp" aria-label="驗證碼第 @(index + 1) 碼" inputmode="numeric" maxlength="1"
                               placeholder="·" autocomplete="one-time-code"
                               value="@_otp[index]"
                               @ref="_otpRefs[index]"
                               @oninput="e => OnOtpInputAsync(index, e)"
                               @onkeydown="e => OnOtpKeyDownAsync(index, e)" />
                    }
                </div>

                @if (_error is not null)
                {
                    <p class="lf-error" role="alert">@_error</p>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                           Class="lf-submit" Disabled="_busy" OnClick="SubmitOtpAsync"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    驗證並登入
                </MudButton>

                <div class="lf-row">
                    <button type="button" class="lf-link" @onclick="BackToStep1">← 返回</button>
                    <span class="lf-muted">60 秒後可重新發送</span>
                </div>
            </div>
        }
        else
        {
            <div class="lf-body lf-body--tight">
                <div class="lf-ok">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                    驗證成功
                </div>
                @if (_error is not null)
                {
                    <p class="lf-error" role="alert">@_error</p>
                }
                <p class="lf-muted lf-muted--lg">@(Flow is null
                    ? "系統將依帳號角色導向對應工作台（原型中可直接選擇）："
                    : "請選擇要登入的工作台：")</p>
                @if (Flow is not null)
                {
                    <p class="lf-muted">角色選擇剩餘 @Remaining(_deadline) 秒</p>
                    <button type="button" class="lf-link" disabled="@_busy" @onclick="CancelRealAsync">← 返回</button>
                }

                @if (Flow is null || _roles.Contains(UserRole.MEDICAL_REVIEWER))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                               Class="lf-submit" Disabled="@(_busy || (Flow is not null && Remaining(_deadline) == 0))" OnClick="() => EnterAsync(UserRole.MEDICAL_REVIEWER)">
                        醫療／資料審核人員
                    </MudButton>
                }
                @if (Flow is null || _roles.Contains(UserRole.SYSTEM_ADMIN))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               Class="lf-submit lf-submit--outline" Disabled="@(_busy || (Flow is not null && Remaining(_deadline) == 0))" OnClick="() => EnterAsync(UserRole.SYSTEM_ADMIN)">
                        系統管理／維護人員
                    </MudButton>
                }
            </div>
        }

        <footer class="lf-footer">
            <span>此系統處理敏感醫療資料</span>
            <button type="button" class="lf-link lf-link--underline" @onclick="ShowContactAdmin">疑難請聯絡系統管理人員</button>
        </footer>
    </section>

    @* ---------- 下方可展開：系統處理架構與安全機制 ---------- *@
    <section class="lf-flow">
        <button type="button" class="lf-flow-toggle" aria-expanded="@(_showFlow ? "true" : "false")" aria-controls="lf-flow-body"
                @onclick="() => _showFlow = !_showFlow">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Class="lf-flow-icon" />
            <span>系統處理架構與安全機制 (點擊檢視 5 階段流程)</span>
            <MudIcon Icon="@(_showFlow ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="lf-flow-chevron" />
        </button>

        @if (_showFlow)
        {
            <div id="lf-flow-body" class="lf-flow-body">
                <ol class="lf-flow-steps">
                    @for (var i = 0; i < FlowSteps.Length; i++)
                    {
                        <li>
                            <span class="lf-flow-num">@(i + 1)</span>
                            <div>
                                <div class="lf-flow-title">@FlowSteps[i].Title</div>
                                <div class="lf-flow-desc">@FlowSteps[i].Desc</div>
                            </div>
                        </li>
                    }
                </ol>
                <p class="lf-flow-note">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Class="lf-flow-note-icon" />
                    病人可識別資料不離開院內網路；僅去識別化文字傳送至雲端。
                </p>
            </div>
        }
    </section>
</div>

@code {
    private IAuthService Auth => Services.GetRequiredService<IAuthService>();

    [CascadingParameter] private DevAuthFlow? Flow { get; set; }

    private ElementReference _form;
    private bool _interactive;
    private IReadOnlyList<UserRole> _roles = [];

    private ElementReference _otpForm;
    private CancellationTokenSource? _countdown;
    private DateTimeOffset _deadline;
    private DateTimeOffset _resendAt;
    private bool _prepareOtp;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Flow is null) return;
        if (firstRender)
        {
            Flow.EnableBrowserInterop();
            var recovery = await Flow.RecoverLoginAsync();
            if (recovery.Status == AuthApiStatus.Authenticated)
            {
                Nav.NavigateTo(DevAuthWebRegistration.IdentityPath, forceLoad: true);
                return;
            }
            if (recovery.Status != AuthApiStatus.LoggedOut)
                _error = $"無法確認先前的驗證已取消。{DevAuthFlow.Error(recovery)}";
            _interactive = true;
            StateHasChanged();
        }
        if (_prepareOtp && _step == 2)
        {
            _prepareOtp = false;
            try { await Flow.PrepareOtpAsync(_otpForm); }
            catch (Microsoft.JSInterop.JSException)
            {
                ResetRealState();
                _error = "無法初始化驗證輸入，請重新登入。";
                StateHasChanged();
            }
        }
    }


    private Task SubmitMockButtonAsync() =>
        Flow is null ? SubmitCredentialsAsync() : Task.CompletedTask;

    private const int OtpLength = 6;

    private static readonly (string Title, string Desc)[] FlowSteps =
    [
        ("上傳與 SHA-256 重複檢查", "建立 BatchID / CaseID；重複檔案直接回傳既有結果，不重複解析。"),
        ("地端 OCR 與去識別化", "PaddleOCR／Qwen2.5-VL 辨識文字，Presidio 遮蔽個資，全程在院內完成。"),
        ("個資安全檢查", "確認遮蔽完整、OCR 品質與資料完整性符合條件，才允許傳送至雲端。"),
        ("雲端 AI Agent 解析與自動驗證", "擷取結構化欄位並附信心值，檢查必要欄位、數值合理性與信心值門檻。"),
        ("人工覆核與 FHIR 寫入", "確認重要結果後依 TW Core 轉換驗證，寫入院內 FHIR Server 並產生稽核軌跡。"),
    ];

    private int _step = 1;
    private bool _busy;
    private bool _showPassword;
    private bool _showFlow;
    private string? _error;

    private string _username = string.Empty;
    private string _password = string.Empty;

    private readonly string[] _otp = new string[OtpLength];
    private readonly ElementReference[] _otpRefs = new ElementReference[OtpLength];

    private string StepClass(int step) => _step >= step ? "lf-step is-on" : "lf-step";

    private async Task SubmitCredentialsAsync()
    {
        if (_busy || _step != 1 || (Flow is not null && !_interactive))
            return;

        _busy = true;
        _error = null;

        if (Flow is not null)
        {
            try
            {
                var response = await Flow.LoginAsync(_form);
                if (response is { Status: AuthApiStatus.OtpRequired, ExpiresInSeconds: int expires,
                                  ResendAfterSeconds: int resend })
                {
                    var now = DateTimeOffset.UtcNow;
                    _deadline = now.AddSeconds(expires);
                    _resendAt = now.AddSeconds(resend);
                    _prepareOtp = true;
                    _step = 2;
                    StartCountdown();
                }
                else
                    _error = DevAuthFlow.Error(response);
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        var result = await Auth.ValidateCredentialsAsync(_username, _password);

        _busy = false;
        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        Array.Fill(_otp, string.Empty);
        _step = 2;
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitCredentialsAsync();
        }
    }

    private async Task OnOtpInputAsync(int index, ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());
        _otp[index] = digits.Length > 0 ? digits[^1].ToString() : string.Empty;

        if (_otp[index].Length == 1 && index < OtpLength - 1)
        {
            await _otpRefs[index + 1].FocusAsync();
        }
    }

    private async Task OnOtpKeyDownAsync(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_otp[index]) && index > 0)
        {
            await _otpRefs[index - 1].FocusAsync();
        }
        else if (e.Key == "Enter")
        {
            await SubmitOtpAsync();
        }
    }

    private async Task SubmitOtpAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.VerifyMfaAsync(string.Concat(_otp));

        _busy = false;
        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        _step = 3;
    }

    private void BackToStep1()
    {
        _error = null;
        _step = 1;
    }

    private static int Remaining(DateTimeOffset until) =>
        Math.Max(0, (int)Math.Ceiling((until - DateTimeOffset.UtcNow).TotalSeconds));

    private void StartCountdown()
    {
        StopCountdown();
        _countdown = new CancellationTokenSource();
        _ = TickAsync(_countdown.Token);
    }

    private async Task TickAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
                if (Remaining(_deadline) == 0) break;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private void StopCountdown()
    {
        _countdown?.Cancel();
        _countdown?.Dispose();
        _countdown = null;
    }

    public void Dispose() => StopCountdown();

    private async Task VerifyRealOtpAsync()
    {
        if (Flow is null || _busy || _step != 2 || Remaining(_deadline) == 0) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Flow.VerifyOtpAsync(_otpForm);
            if (result.Status == AuthApiStatus.Authenticated)
            {
                ResetRealState();
                await ContinueAuthenticatedAsync();
            }
            else if (result is { Status: AuthApiStatus.RoleSelectionRequired, AvailableRoles: { } roles,
                         ExpiresInSeconds: int expires })
            {
                _roles = roles;
                _deadline = DateTimeOffset.UtcNow.AddSeconds(expires);
                _step = 3;
                StartCountdown();
            }
            else if (result.Status is AuthApiStatus.ProxyError or AuthApiStatus.NetworkError or
                     AuthApiStatus.ProtocolError or AuthApiStatus.ServiceUnavailable)
                ResetRealState();
            if (result.Status is not (AuthApiStatus.Authenticated or AuthApiStatus.RoleSelectionRequired))
                _error = DevAuthFlow.Error(result);
        }
        finally { _busy = false; }
    }

    private async Task ResendRealOtpAsync()
    {
        if (Flow is null || _busy || _step != 2 || Remaining(_deadline) == 0 || Remaining(_resendAt) > 0) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Flow.ResendOtpAsync(_otpForm);
            if (result is { Status: AuthApiStatus.OtpRequired, ExpiresInSeconds: int expires,
                            ResendAfterSeconds: int resend })
            {
                var now = DateTimeOffset.UtcNow;
                var updatedDeadline = now.AddSeconds(expires);
                if (updatedDeadline < _deadline) _deadline = updatedDeadline;
                _resendAt = now.AddSeconds(resend);
                return;
            }
            if (result is { Status: AuthApiStatus.RateLimited, RetryAfter: TimeSpan wait })
                _resendAt = DateTimeOffset.UtcNow.Add(wait < TimeSpan.FromMinutes(15) ? wait : TimeSpan.FromMinutes(15));
            else if (result.Status is not AuthApiStatus.VerificationPending)
                ResetRealState();
            _error = DevAuthFlow.Error(result);
        }
        finally { _busy = false; }
    }

    private async Task CancelRealAsync()
    {
        if (_busy || Flow is null) return;
        _busy = true;
        ResetRealState();
        try
        {
            var result = await Flow.LogoutAsync();
            _error = result.Status == AuthApiStatus.LoggedOut
                ? null : $"無法確認伺服器已取消驗證。{DevAuthFlow.Error(result)}";
        }
        finally { _busy = false; }
    }

    private async Task ContinueAuthenticatedAsync()
    {
        var confirmed = await Flow!.MeAsync();
        if (confirmed.Status == AuthApiStatus.Authenticated)
            Nav.NavigateTo(DevAuthWebRegistration.IdentityPath, forceLoad: true);
        else
            _error = DevAuthFlow.Error(confirmed);
    }

    private void ResetRealState()
    {
        StopCountdown();
        _roles = [];
        _prepareOtp = false;
        _step = 1;
        _password = string.Empty;
    }

    private void ShowForgotPassword() =>
        Snackbar.Add("請聯絡系統管理人員重設密碼。", Severity.Info);

    private void ShowContactAdmin() =>
        Snackbar.Add("系統管理人員：admin.huang（分機 1234）", Severity.Info);

    private async Task EnterAsync(UserRole role)
    {
        if (_busy)
            return;

        if (Flow is not null)
        {
            if (_step != 3 || Remaining(_deadline) == 0 || !_roles.Contains(role))
                return;

            _busy = true;
            _roles = [];
            try
            {
                var response = await Flow.SelectRoleAsync(role);
                ResetRealState();
                if (response.Status == AuthApiStatus.Authenticated)
                    await ContinueAuthenticatedAsync();
                else
                    _error = DevAuthFlow.Error(response);
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        var destination = role switch
        {
            UserRole.MEDICAL_REVIEWER => "/reviewer",
            UserRole.SYSTEM_ADMIN => "/admin",
            _ => null
        };

        if (destination is null)
            return;

        await Auth.CompleteSignInAsync(role);
        Nav.NavigateTo(destination);
    }
    
}
