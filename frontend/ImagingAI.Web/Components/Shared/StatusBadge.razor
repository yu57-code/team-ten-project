@* 狀態徽章：<StatusBadge Tone="BadgeTone.Ok">已完成</StatusBadge> 或 <StatusBadge Tone="..." Text="..." /> *@

<span class="@StatusStyles.CssClass(Tone)">@if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }</span>

@code {
    [Parameter] public BadgeTone Tone { get; set; } = BadgeTone.Mute;

    [Parameter] public string? Text { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
